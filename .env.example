# Application Configuration
APP_NAME=Lexicon
APP_URL=http://lexicon.test/
APP_ENV=development
APP_DEBUG=true
APP_KEY=BE77TkpAgBuPpkSNEoygFg9/7Ebv58hfPp+oLK5/UyY=

# Database Configuration
DB_HOST=localhost
DB_NAME=lexicon
DB_USER=lexicon_user
DB_PASSWORD=1234

# Error Handling
SHOW_ERRORS=1

# Security & Performance
FORCE_HTTPS=0
FORCE_WWW=0
# Maintenance is toggled via storage/maintenance.json (admin Settings or deploy scripts).
# The values below are defaults snapshotted into the flag file when it is enabled.
MAINTENANCE_ALLOW="127.0.0.1,10.0.0.0/8,192.168.0.0/16"
MAINTENANCE_RETRY_AFTER=600

# Mail Configuration
MAIL_ENABLED=false
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@localhost.test
MAIL_FROM_NAME="Lexicon"
MAIL_DEBUG=true

# Mail queue pacing, drained by: php cli mail:queue-work (run every minute)
# Lower the batch size or raise the delay if the provider rejects bursts.
MAIL_QUEUE_BATCH_SIZE=10
MAIL_QUEUE_DELAY_MS=500
MAIL_QUEUE_MAX_ATTEMPTS=3
MAIL_QUEUE_BACKOFF_SECONDS=60
MAIL_QUEUE_STUCK_AFTER_MINUTES=15

# Cache Configuration
CACHE_ENABLED=true
CACHE_GC_PROBABILITY=1
CACHE_GC_DIVISOR=100
CACHE_MAX_FILES=5000

# Query Logging (disable in production)
DB_LOG_QUERIES=false

# Slow Query Logging (minimal performance impact)
DB_LOG_SLOW_QUERIES=true
DB_SLOW_QUERY_THRESHOLD=1.0