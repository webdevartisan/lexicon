# Application Configuration
APP_NAME=Lexicon
APP_URL=https://lexicon.test/
APP_ENV=development
APP_DEBUG=true
APP_KEY=

# Database Configuration
DB_HOST=localhost
DB_NAME=lexicon
DB_USER=lexicon_user
DB_PASSWORD=1234

# Error Handling
SHOW_ERRORS=1

# Security & Performance
FORCE_HTTPS=1
FORCE_WWW=0
# false sends the Content-Security-Policy as report-only (violations are logged, not blocked).
# Set to true in production.
CSP_ENFORCE=false
# Password strength enforced on sign-up, reset and admin forms: basic, medium or strong
# (see Framework\Validation\Validator::parsePasswordRequirements). Set to strong in production.
PASSWORD_POLICY_PRESET=basic
# Accounts that can open the control panel must use an authenticator app before /admin opens.
TWO_FACTOR_REQUIRED_FOR_ADMINS=true
# Maintenance is toggled via storage/maintenance.json (admin Settings or deploy scripts).
# The values below are defaults snapshotted into the flag file when it is enabled.
# Matched against the client IP. Without TRUSTED_PROXIES that is the proxy's address behind nginx
# or a load balancer, so never allow private ranges (10.x, 192.168.x) here.
MAINTENANCE_ALLOW="127.0.0.1"
# Reverse proxies whose X-Forwarded-For, X-Forwarded-Proto and X-Forwarded-SSL are believed:
# comma-separated IPs or CIDRs, never wildcards. Behind a TLS-terminating proxy this must be set,
# or the HTTPS redirect sees plain HTTP on every request and loops.
# Leave empty when the app is reached directly. Same-host nginx: 127.0.0.1,::1
TRUSTED_PROXIES=
MAINTENANCE_RETRY_AFTER=600

# Mail Configuration
MAIL_ENABLED=false
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@localhost.test
MAIL_FROM_NAME="Lexicon"
MAIL_DEBUG=true

# Mail queue pacing, drained by: php cli mail:queue-work (run every minute)
# Lower the batch size or raise the delay if the provider rejects bursts.
MAIL_QUEUE_BATCH_SIZE=10
MAIL_QUEUE_DELAY_MS=500
MAIL_QUEUE_MAX_ATTEMPTS=3
MAIL_QUEUE_BACKOFF_SECONDS=60
MAIL_QUEUE_STUCK_AFTER_MINUTES=15

# Task scheduler. Cron needs one entry and nothing else:
#   * * * * * cd /path/to/app && php cli schedule:run >> /dev/null 2>&1
# Everything else is configured under System, Scheduled Tasks.
# Set the binary when tasks fail to start. It is needed where PHP runs under
# Apache or php-fpm, because there the running program is the web server rather
# than the command line build, and on Windows where the compiled in path
# usually points somewhere that does not exist.
# SCHEDULE_PHP_BINARY=/usr/bin/php
SCHEDULE_RUN_BUDGET=50
SCHEDULE_MAX_TASKS=20
SCHEDULE_HISTORY_DAYS=30
SCHEDULE_PSEUDO_CRON=false

# Cache Configuration
CACHE_ENABLED=true
CACHE_GC_PROBABILITY=1
CACHE_GC_DIVISOR=100
CACHE_MAX_FILES=5000

# Query Logging (disable in production)
DB_LOG_QUERIES=false

# Slow Query Logging (minimal performance impact)
DB_LOG_SLOW_QUERIES=true
DB_SLOW_QUERY_THRESHOLD=1.0

# Sessions (config/session.php)
# file, database or redis. Changing it signs everyone out. Anything else stops
# the application at startup.
SESSION_DRIVER=database
SESSION_COOKIE=PHPSESSID
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=720
# Accounts that can open the control panel
SESSION_PRIVILEGED_IDLE_MINUTES=60
SESSION_PRIVILEGED_ABSOLUTE_HOURS=24
SESSION_GUEST_IDLE_MINUTES=120
# Only for SESSION_DRIVER=redis. Use maxmemory-policy noeviction (or volatile-*)
# so Redis never drops a session to make room, and turn on appendonly if a
# restart should not sign everyone out.
SESSION_REDIS_HOST=127.0.0.1
SESSION_REDIS_PORT=6379
SESSION_REDIS_PASSWORD=
SESSION_REDIS_DB=0
SESSION_REDIS_PREFIX=lx_sess:

# Sign-in check (config/captcha.php): a proof-of-work challenge solved in the
# browser, verified here with an HMAC. Nothing goes to a third party.
# altcha is the only provider; anything else stops the application at startup.
CAPTCHA_PROVIDER=altcha
# Leave empty to derive the key from APP_KEY.
CAPTCHA_HMAC_KEY=
# PBKDF2 iterations per guess, and the guess range a level-0 challenge hides
# its answer in. Each level doubles the range, up to CAPTCHA_MAX_LEVEL.
CAPTCHA_COST=1000
CAPTCHA_COUNTER_MIN=125
CAPTCHA_COUNTER_MAX=375
CAPTCHA_MAX_LEVEL=3
CAPTCHA_EXPIRES_SECONDS=300
